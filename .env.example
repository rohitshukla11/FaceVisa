# FaceVisa (ETHGlobal Mumbai). Copy to .env.local (git-ignored) and fill in; never commit real values.
# `cd agents && pnpm app` reads ../.env.local if it exists. The web (Next.js) needs only FACEVISA_BACKEND.
# SECRET marks values that must never be printed, logged, pasted or committed.

# ---------------------------------------------------------------- World ID sign-in (OIDC, B1)
# The issuer; endpoints and signing keys come from its discovery document.
#   sandbox:    https://sandbox.auth.world.org   (test identities, "Manual verify")
#   production: https://auth.world.org
WORLDID_ISSUER=https://sandbox.auth.world.org
# From the World ID developer portal for this app (sandbox apps are registered in the sandbox's portal).
WORLDID_CLIENT_ID=
# How our backend authenticates to the token endpoint: set ONE of these two.
# client_secret_basic. SECRET. Sent only to the token endpoint, in the Authorization header.
WORLDID_CLIENT_SECRET=
# private_key_jwt: path to the client's RSA private key (PEM, mode 600, outside git). SECRET file; its public key
# is registered with the client, and the kid is its RFC 7638 thumbprint.
WORLDID_PRIVATE_KEY_FILE=
# The callbacks registered in the World ID portal (HTTPS). Default: ${PUBLIC_URL}/api/auth/callback and
# ${PUBLIC_URL}/api/agent-pass/callback; the backend answers at the path you register. Local HTTPS (web on
# https://localhost:3000, `pnpm dev:https`; another port with WEB_PORT=…, and PUBLIC_URL to match):
WORLDID_SIGNIN_REDIRECT_URI=https://localhost:3000/api/auth/callback
# The Agent Pass checkpoint's callback (used from B2).
WORLDID_AGENT_PASS_REDIRECT_URI=https://localhost:3000/api/agent-pass/callback

# SECRET. Signs our session cookie. At least 32 random characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=

# The HTTPS origin of the site as the browser sees it (the web, which proxies /api to the backend on
# 127.0.0.1:8788). POSTs must come from this origin. Local: https://localhost:3000.
PUBLIC_URL=https://localhost:3000

# ---------------------------------------------------------------- Agent Pass and the brand agent
# How long a licence request waits for the creator (minutes), and how fresh their World ID check must be to approve.
AGENT_PASS_REQUEST_TTL_MIN=10
AGENT_PASS_FRESH_WINDOW_MIN=5
# What one brand may spend per UTC day (USD), and how long an approved licence lasts (days).
FACEVISA_BRAND_DAILY_BUDGET=1.00
# Above this price per request (USD), the brand's agent pauses until the brand's own human approves the spend with a
# fresh World ID check. Empty = the agent never pauses for spend (within the daily budget).
BRAND_STEPUP_USDC=0.10
FACEVISA_LICENCE_DAYS=30

# ---------------------------------------------------------------- local development only
# 1 allows the local-development switches below (and DevConsent when World ID isn't configured). Ignored with
# NODE_ENV=production or FACEVISA_MODE=mainnet. Never set it on a deployed server.
FACEVISA_LOCAL_DEV=
# Needs FACEVISA_LOCAL_DEV=1: 1 replaces World ID with a click-through local stand-in at ${PUBLIC_URL}/api/dev/worldid,
# its own issuer (accounts never mix with real World ID). The WORLDID_* lines stay for later.
WORLDID_STANDIN=

# ---------------------------------------------------------------- the backend
# local (this machine; local-development switches allowed) | testnet | mainnet (deployed; never)
FACEVISA_MODE=local
PORT=8788
# 1 behind a reverse proxy on a public host: per-IP rate limits.
FACEVISA_PUBLIC=
# Who makes each kind of media (agents/src/ai/media.ts). Each call is billed and counts against the daily caps below.
#   FACEVISA_AI_IMAGE  images, and a video's opening still: 0g (Seedream 5.0 Flash, $0.027) or vertex (Gemini)
#   FACEVISA_AI_VIDEO  the video, animated from that still (first frame): vertex (Veo). 0g (Seedance) refuses real
#                      people's faces (0g/friction.md), so it can't animate a creator.
#   empty = TEST RENDERs (no model call). Unset = the legacy FACEVISA_AI below.
FACEVISA_AI_IMAGE=0g
FACEVISA_AI_VIDEO=vertex
# Legacy alias, used only while FACEVISA_AI_IMAGE / FACEVISA_AI_VIDEO are unset: vertex = both on Vertex.
FACEVISA_AI=
# Optional: when 0G refuses a video, make it on Vertex instead. Empty = the request fails with "0G refused this video".
FACEVISA_AI_VIDEO_FALLBACK=
# SECRET file: the 0G Compute Router API key (sk-…), chmod 600, outside git. Default: .secrets/zerog-api-key
ZEROG_API_KEY_FILE=
# 0G video resolution if FACEVISA_AI_VIDEO=0g: 480p (default), 720p or 1080p.
ZEROG_VIDEO_RESOLUTION=
# This app's own GCP project (likeness-eth). Empty = real generation off. likeness-hsk and bionic-carving-140911 are
# refused at startup.
VERTEX_PROJECT=
# Daily caps on billed model calls (UTC day), what actually limits Vertex spend (the GCP budget alert only notifies).
# Every image call counts (a video's opening still and each regeneration too), and every video call.
FACEVISA_BRAND_IMAGES=3
FACEVISA_BRAND_VIDEOS=1
FACEVISA_SITE_IMAGES=10
FACEVISA_SITE_VIDEOS=2
# The gcloud configuration for Vertex AI tokens: this app's own (likeness-eth). likeness-hsk and default are refused.
# Empty = Application Default Credentials, refused unless their quota project is VERTEX_PROJECT.
FACEVISA_GCLOUD_CONFIG=likeness-eth

# ---------------------------------------------------------------- the face gate (local matcher)
# The models (`cd agents && pnpm face:models`, sha256-pinned, ~250 MB). Present = every output is face-checked and a
# capture must show one person; absent = receipts say "face check: not run". Default: .models at the repo root.
FACE_MODELS_DIR=
# Same person in a generated ad at or above this cosine similarity (calibrated on a small sample: tune on real data).
CONSENT_FACE_MATCH_THRESHOLD=0.35
# The capture's frames are one person at or above this.
LOCAL_FACE_MATCH_THRESHOLD=0.55

# ---------------------------------------------------------------- YouTube channel linking (optional)
# A Google OAuth client ("Web application") in the likeness-eth GCP project, with YouTube Data API v3 enabled there.
# Not a sign-in: a signed-in creator links their channel once, for the youtube.readonly scope only. The token is used
# once in the backend and never stored. Both empty = linking is off (the Link button doesn't show).
GOOGLE_OAUTH_CLIENT_ID=
# SECRET.
GOOGLE_OAUTH_CLIENT_SECRET=
# Register exactly this as an authorized redirect URI. Empty = ${PUBLIC_URL}/api/facevisa/youtube/callback.
YOUTUBE_REDIRECT_URI=

# ---------------------------------------------------------------- Proof of Presence (B6): World ID Selfie Check before listing
# An IDKit 4 app at developer.world.org (a separate portal from the auth.world.org sign-in client). All three, or none:
# none = listing doesn't require Proof of Presence.
WORLD_APP_ID=
WORLD_RP_ID=
# SECRET file: the RP signing key (32-byte hex) from the portal, chmod 600, outside git,
# e.g. `umask 077; pbpaste > .secrets/world-rp-signing-key`.
WORLD_RP_SIGNING_KEY_FILE=
# The one-time action (World ID lets each person complete an action once):
#   list-likeness-dev  development (the default)
#   presence-test      a first enrolment from a stand-in session
#   list-likeness      the final demo only: refused unless ARKIV_SCHEMA_PREFIX=facevisa-v1
WORLD_IDKIT_ACTION=list-likeness-dev
# production (default). staging and sandbox accept test proofs: only with FACEVISA_LOCAL_DEV=1.
WORLD_IDKIT_ENVIRONMENT=production
# Accept a sybil_score (0–10, a risk signal) up to this. World's illustrative bands: under 2 low, 2–4 medium,
# 4–6 high, 6+ very high (not validated thresholds).
PRESENCE_MAX_SYBIL_SCORE=3

# ---------------------------------------------------------------- payments: USDT on Whitechain testnet (the default)
# whitechain (default) | hedera (USDC over x402, below) | dev (DevPayment: records only, no money moves).
PAYMENTS=whitechain
# FaceVisaSettlement on Whitechain Sepolia (chain 1874), deployed from contracts/. Empty = DevPayment.
WHITECHAIN_SETTLEMENT=0x8fbbca9e637c6261386e38dfef016a7dd90fc65b
# Defaults: https://rpc.testnet.whitechain.io, https://explorer.testnet.whitechain.io, USDT 0xcedfB561…f55a7.
WHITECHAIN_RPC_URL=
WHITECHAIN_EXPLORER=
# SECRET files (chmod 600, outside git): the relayer (holds WBT only, pays gas; the contract's relayer) and the operator
# (holds the demo's USDT reserve for top-ups). Defaults: .secrets/whitechain-relayer-key, .secrets/whitechain-operator-key
WHITECHAIN_RELAYER_KEY_FILE=
WHITECHAIN_OPERATOR_KEY_FILE=
# FaceVisa's own caps, on top of the contract's (1.00 per payment, 20.00 a day): USDT. Gas price ceiling in gwei; health
# warns when the relayer's WBT falls under WHITECHAIN_RELAYER_LOW_WBT.
WHITECHAIN_MAX_PER_PAYMENT_USDT=1.00
WHITECHAIN_MAX_PER_DAY_USDT=20.00
WHITECHAIN_MAX_GAS_GWEI=50
WHITECHAIN_RELAYER_LOW_WBT=0.05

# ---------------------------------------------------------------- Hedera (B4): x402 payments on testnet (PAYMENTS=hedera)
# The operator: a Hedera Portal testnet account. It pays for creating each account's Hedera account and its USDC
# association. Only its ID goes here; its key goes in a file.
HEDERA_OPERATOR_ID=
# SECRET file: the operator's HEX ECDSA private key, chmod 600, outside git. Default: .secrets/hedera-operator-key
HEDERA_OPERATOR_KEY_FILE=
# testnet only (for now). Testnet USDC is 0.0.429274 (6 decimals).
HEDERA_NETWORK=testnet
# Ignored now: PAYMENTS=hedera turns this on. Pay to release: every new release is paid by the brand agent's x402 client, in USDC, to the creator's Hedera
# account (GET /api/x402/ads/:requestId). Needs the operator above and FACEVISA_KEYSTORE_PASSWORD_FILE. Empty =
# DevPayment (records only, no money moves).
HEDERA_X402=
# The x402 facilitator that verifies and settles (it pays the network fee). Default: https://x402.org/facilitator
X402_FACILITATOR_URL=
# pnpm hedera:fund-brand: the most USDC one top-up may send from the operator's reserve (default 10; 20 a day in all).
HEDERA_FUND_MAX_USDC=

# ---------------------------------------------------------------- keys (the encrypted keystore)
# Path to a file holding the keystore's password (16+ characters; relative paths from the repo root). SECRET file:
# chmod 600, outside git, e.g. `umask 077; openssl rand -base64 48 > .secrets/keystore-password`. The keystore itself
# is keystores/<FACEVISA_MODE>/keystore.json (git-ignored): one custodial secp256k1 key per account, generated on first
# need, plus the platform's "receipt" and "funder" keys. Lose the password and those keys (and their tGLM) are gone.
# `cd agents && pnpm arkiv:keys` creates the platform keys and prints only their addresses.
FACEVISA_KEYSTORE_PASSWORD_FILE=

# ---------------------------------------------------------------- Arkiv (B5): public state mirrored on Rabdi
# 1 = mirror public state (listings, requests, licences, receipts) to Arkiv through the outbox (agents/src/arkiv/).
# Needs FACEVISA_KEYSTORE_PASSWORD_FILE and a funder holding tGLM (faucet: https://hub.arkiv.network/faucet).
ARKIV_ENABLED=
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_CHAIN_ID=7794095
# SECRET. From https://hub.arkiv.network/access-keys (one per wallet per network). The SDK puts it in the RPC URL
# path, so RPC URLs and raw SDK errors are never logged.
ARKIV_ACCESS_KEY=
# The `app` attribute on every entity this app writes, and its schema names (<prefix>.listing, …); a new value
# starts a fresh namespace (everything is mirrored again).
ARKIV_SCHEMA_PREFIX=facevisa-v1
ARKIV_EXPLORER_URL=https://rabdi.explorer.arkiv.network
# tGLM the funder sends an account key (or the receipt key) holding under 0.005 before it writes; at most 1, at most
# twice a day per key and 20 a day in all. Default 0.05: measured on Rabdi (3 Nov), a create costs ~314,000 gas and a
# patch ~52,000, at 1 gwei: 0.05 tGLM is ~150 creates.
ARKIV_FUNDER_TOPUP=

# ---------------------------------------------------------------- the web (web/.env.local)
# Where Next.js proxies /api.
FACEVISA_BACKEND=http://127.0.0.1:8788
NEXT_PUBLIC_APP_URL=https://localhost:3000
